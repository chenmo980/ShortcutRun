{
  "_说明": "room-gateway 成员表模板。复制为 tools/members.json 后按需改（本机文件已 gitignore）。token 不放文件里，走 CHAT_TOKEN 环境变量。",
  "_唤醒现实": "2026-09-24 实测本机 PATH 只有 claude CLI，无 qoder/opencode——@唤醒对 runtime 不对称。故默认全部 echo 提示型（SAFE 铃）；哪个成员的 headless CLI 真实可用才改成真命令，并配 --live。",
  "pollMs": 5000,
  "roomUrl": "http://127.0.0.1:8787",
  "cooldownMs": 120000,
  "members": {
    "step-5": { "match": ["@step-5", "@all"], "cmd": "node tools/wake-opencode.mjs", "_注释": "API型唤醒: 走opencode server(桌面app自带:50087, 凭据在环境变量); 前置见docs/chat/OPENCODE-API-SETUP.md" },
    "qoder": {
      "match": ["@qoder"],
      "cmd": "node tools/wake-worker.mjs"
    },
    "human": {
      "match": ["@human"],
      "cmd": "echo [gateway] human 被点名: {prompt}"
    },
    "cloud-ai": {
      "_注释": "cloud-ai 就位后同样用 wake-worker（自动探测其环境的 CLI）",
      "match": ["@cloud-ai", "@all"],
      "cmd": "node tools/wake-worker.mjs"
    }
  }
}
